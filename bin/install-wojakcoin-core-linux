#!/usr/bin/env bash

set -euxo pipefail

version=1.1.0

wget \
  -O wojakcoin.tar.gz \
  https://github.com/wojakcoinppc/wojakcoin/releases/download/v$version/wojakcoin-$version-x86_64-linux-gnu.tar.gz

tar \
  -xzvf wojakcoin.tar.gz \
  -C /usr/local/bin \
  --strip-components 1 \
  wojakcoin-$version/bin/{wojakcoin-cli,wojakcoind}
